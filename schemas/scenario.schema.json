{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/scenario-v2.json",
  "title": "SocialFlux Canonical Scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "title",
    "mechanism",
    "source",
    "narrative_design",
    "construction_status",
    "quality_gate",
    "background",
    "environment_agent",
    "evaluated_agent_role",
    "initial_state",
    "initial_dynamics",
    "max_turns"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "provenance_id",
        "surface_text_policy",
        "redistribution_status"
      ],
      "properties": {
        "type": {
          "enum": [
            "narrative-derived",
            "synthetic-script"
          ]
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_text_policy": {
          "const": "original_surface_text"
        },
        "redistribution_status": {
          "type": "string",
          "minLength": 1
        },
        "provenance_note": {
          "type": "string"
        },
        "work_title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "related_characters_or_plot_position": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "narrative_design": {
      "type": "object",
      "required": [
        "relationship_structure",
        "power_structure",
        "goal_conflict",
        "information_asymmetry",
        "relevant_history",
        "meaningful_choice_space"
      ],
      "properties": {
        "relationship_structure": {
          "type": "string",
          "minLength": 1
        },
        "power_structure": {
          "type": "string",
          "minLength": 1
        },
        "goal_conflict": {
          "type": "string",
          "minLength": 1
        },
        "information_asymmetry": {
          "type": "string",
          "minLength": 1
        },
        "relevant_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "meaningful_choice_space": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "construction_status": {
      "type": "object",
      "required": [
        "normalization",
        "initial_state",
        "quality_gate"
      ],
      "properties": {
        "normalization": {
          "type": "string"
        },
        "initial_state": {
          "enum": [
            "candidate_pending_human_freeze",
            "human_frozen"
          ]
        },
        "quality_gate": {
          "enum": [
            "pending_human_review",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "quality_gate": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "enum": [
          "pending",
          "pass",
          "fail"
        ]
      }
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "environment_agent": {
      "$ref": "#/$defs/environmentAgent"
    },
    "evaluated_agent_role": {
      "type": "object",
      "required": [
        "character_id",
        "name",
        "explicit_goal"
      ],
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selected_state_variables": {
      "type": "object"
    },
    "target_state_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initial_state": {
      "$ref": "#/$defs/boundedObject"
    },
    "initial_dynamics": {
      "$ref": "#/$defs/boundedObject"
    },
    "opening_response": {
      "type": "string"
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1
    },
    "t3_delayed_horizon": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "sampling_plan": {
      "type": "object"
    },
    "termination_conditions": {
      "type": "array"
    },
    "observable_expression": {
      "type": "object"
    },
    "media_generation": {
      "type": "object"
    },
    "video_triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/videoTrigger"
      }
    },
    "initialization_notes": {
      "type": "object",
      "required": [
        "rationale",
        "trigger_reachability"
      ],
      "properties": {
        "rationale": {
          "type": "object"
        },
        "trigger_reachability": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "action_effects"
        ]
      },
      {
        "required": [
          "response_templates"
        ]
      },
      {
        "required": [
          "observable_cues_by_action"
        ]
      }
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "environmentAgent": {
      "type": "object",
      "required": [
        "persona",
        "explicit_goal",
        "hidden_intention"
      ],
      "properties": {
        "persona": {
          "type": "object"
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "hidden_intention": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "boundedObject": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          {
            "$ref": "#/$defs/boundedObject"
          }
        ]
      }
    },
    "videoTrigger": {
      "type": "object",
      "required": [
        "trigger_id",
        "trigger_mode",
        "conditions",
        "cue_template",
        "observable_expression"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger_mode": {
          "enum": [
            "threshold",
            "crossing",
            "state_change"
          ]
        },
        "conditions": {
          "type": "object"
        },
        "change_conditions": {
          "type": "object"
        },
        "cooldown_turns": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "cue_template": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 3,
          "maximum": 8
        },
        "media_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observable_expression": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    }
  },
  "$comment": "A scenario defines a social world, never a navigation strategy or expected action transition. Rollouts must come from free-form model interaction."
}
