{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/scenario-v2.json",
  "title": "SocialFlux Canonical Scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "title",
    "mechanism",
    "source",
    "narrative_design",
    "construction_status",
    "quality_gate",
    "background",
    "environment_agent",
    "evaluated_agent_role",
    "initial_state",
    "initial_dynamics",
    "max_turns"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "provenance_id",
        "surface_text_policy",
        "redistribution_status"
      ],
      "properties": {
        "type": {
          "enum": [
            "narrative-derived",
            "synthetic-script"
          ]
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_text_policy": {
          "const": "original_surface_text"
        },
        "redistribution_status": {
          "type": "string",
          "minLength": 1
        },
        "provenance_note": {
          "type": "string"
        },
        "work_title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "related_characters_or_plot_position": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "policy_background": {"type": "string", "minLength": 1},
    "environment_background": {"type": "string", "minLength": 1},
    "shared_background": {"type": "string"},
    "environment_visible_narrative": {"$ref": "#/properties/policy_visible_narrative"},
    "policy_visible_narrative": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(relationship_structure|power_structure|goal_conflict|relevant_history\\.(0|[1-9][0-9]*))$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "narrative_design": {
      "type": "object",
      "required": [
        "relationship_structure",
        "power_structure",
        "goal_conflict",
        "information_asymmetry",
        "relevant_history",
        "meaningful_choice_space"
      ],
      "properties": {
        "relationship_structure": {
          "type": "string",
          "minLength": 1
        },
        "power_structure": {
          "type": "string",
          "minLength": 1
        },
        "goal_conflict": {
          "type": "string",
          "minLength": 1
        },
        "information_asymmetry": {
          "type": "string",
          "minLength": 1
        },
        "relevant_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "meaningful_choice_space": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "construction_status": {
      "type": "object",
      "required": [
        "normalization",
        "initial_state",
        "quality_gate"
      ],
      "properties": {
        "normalization": {
          "type": "string"
        },
        "initial_state": {
          "enum": [
            "candidate_pending_human_freeze",
            "human_frozen"
          ]
        },
        "quality_gate": {
          "enum": [
            "pending_human_review",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "quality_gate": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "enum": [
          "pending",
          "pass",
          "fail"
        ]
      }
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "environment_agent": {
      "$ref": "#/$defs/environmentAgent"
    },
    "evaluated_agent_role": {
      "type": "object",
      "required": [
        "character_id",
        "name",
        "role",
        "explicit_goal"
      ],
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "$ref": "#/$defs/privatePersonaV2"
        }
      },
      "additionalProperties": false
    },
    "selected_state_variables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_state_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initial_state": {
      "$ref": "#/$defs/boundedObject"
    },
    "initial_dynamics": {
      "$ref": "#/$defs/boundedObject"
    },
    "opening_response": {
      "type": "string"
    },
    "max_turns": {
      "const": 20
    },
    "longitudinal_design": {
      "$ref": "#/$defs/longitudinalDesign"
    },
    "t3_delayed_horizon": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "sampling_plan": {
      "type": "object"
    },
    "termination_conditions": {
      "type": "array"
    },
    "observable_expression": {
      "type": "object"
    },
    "media_generation": {
      "type": "object"
    },
    "video_triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/videoTrigger"
      }
    },
    "initialization_notes": {
      "type": "object",
      "required": [
        "rationale",
        "trigger_reachability"
      ],
      "properties": {
        "rationale": {
          "type": "object"
        },
        "trigger_reachability": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "state_contract_version": {
      "const": "socialflux_state_v2"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "action_effects"
        ]
      },
      {
        "required": [
          "response_templates"
        ]
      },
      {
        "required": [
          "observable_cues_by_action"
        ]
      }
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "environmentAgent": {
      "type": "object",
      "required": [
        "persona",
        "explicit_goal",
        "hidden_intention"
      ],
      "properties": {
        "persona": {
          "type": "object"
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "hidden_intention": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "boundedObject": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          {
            "$ref": "#/$defs/boundedObject"
          }
        ]
      }
    },
    "longitudinalDesign": {
      "type": "object",
      "required": [
        "format",
        "time_unit",
        "start_elapsed",
        "segments",
        "event_pools"
      ],
      "properties": {
        "format": {
          "const": "socialflux_longitudinal_v1"
        },
        "time_unit": {
          "type": "string",
          "minLength": 1
        },
        "start_elapsed": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/longitudinalSegment"
          }
        },
        "event_pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventPool"
          }
        },
        "numeric_obligation": {
          "$ref": "#/$defs/numericObligation"
        }
      },
      "additionalProperties": false
    },
    "longitudinalSegment": {
      "type": "object",
      "required": [
        "segment_id",
        "reason",
        "min_turns",
        "max_turns"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "interaction_goal": {
          "type": "string",
          "minLength": 1
        },
        "live_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pause_when": {
          "type": "string",
          "minLength": 1
        },
        "min_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "advance_by": {
          "type": "integer",
          "minimum": 1
        },
        "public_time_record": {
          "type": "string",
          "minLength": 1
        },
        "opening_response": {
          "type": "string",
          "minLength": 1
        },
        "precondition_not_met_opening_response": {
          "type": "string",
          "minLength": 1
        },
        "event_pool_id": {
          "type": "string",
          "minLength": 1
        },
        "requires_pending_commitment": {
          "type": "boolean"
        },
        "commitment_speaker": {
          "enum": [
            "evaluated_agent",
            "environment_agent"
          ]
        },
        "commitment_focus": {
          "type": "string",
          "minLength": 1
        },
        "end_on_pending_commitment": {
          "type": "boolean"
        },
        "allow_explicit_pause": {
          "type": "boolean"
        },
        "forbid_new_repayment_commitment": {
          "type": "boolean"
        },
        "precondition_not_met_record": {
          "type": "string",
          "minLength": 1
        },
        "time_effect": {
          "$ref": "#/$defs/sparseDeterministicEffect"
        },
        "commitment_required_terms": {
          "type": "array",
          "items": {
            "enum": [
              "amount",
              "deadline",
              "repayment_action"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "eventPool": {
      "type": "object",
      "required": [
        "event_pool_id",
        "selection",
        "outcomes"
      ],
      "properties": {
        "event_pool_id": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "const": "deterministic_by_trajectory_id"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eventOutcome"
          }
        }
      },
      "additionalProperties": false
    },
    "eventOutcome": {
      "type": "object",
      "required": [
        "outcome_id",
        "public_record",
        "causal_scope",
        "commitment_effect",
        "state_delta",
        "dynamics_delta"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "public_record": {
          "type": "string",
          "minLength": 1
        },
        "causal_scope": {
          "enum": [
            "exogenous",
            "action_mediated"
          ]
        },
        "commitment_effect": {
          "enum": [
            "none",
            "fulfilled",
            "partially_fulfilled",
            "unfulfilled"
          ]
        },
        "commitment_speaker": {
          "enum": [
            "evaluated_agent",
            "environment_agent"
          ]
        },
        "commitment_focus": {
          "type": "string",
          "minLength": 1
        },
        "state_delta": {
          "$ref": "#/$defs/sparseDelta"
        },
        "dynamics_delta": {
          "$ref": "#/$defs/sparseDelta"
        },
        "performance_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "sparseDeterministicEffect": {
      "type": "object",
      "required": [
        "policy",
        "state_delta",
        "dynamics_delta"
      ],
      "properties": {
        "policy": {
          "enum": [
            "none",
            "scenario_authored"
          ]
        },
        "state_delta": {
          "$ref": "#/$defs/sparseDelta"
        },
        "dynamics_delta": {
          "$ref": "#/$defs/sparseDelta"
        }
      },
      "additionalProperties": false
    },
    "sparseDelta": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "strong_decrease",
          "moderate_decrease",
          "mild_decrease",
          "similar",
          "mild_increase",
          "moderate_increase",
          "strong_increase"
        ]
      }
    },
    "videoTrigger": {
      "type": "object",
      "required": [
        "trigger_id",
        "trigger_mode",
        "conditions",
        "priority",
        "cooldown_turns",
        "cue_template",
        "observable_expression"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger_mode": {
          "enum": [
            "threshold",
            "crossing",
            "state_change"
          ]
        },
        "conditions": {
          "type": "object"
        },
        "change_conditions": {
          "type": "object"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "cooldown_turns": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "cue_template": {
          "type": "string",
          "minLength": 1
        },
        "social_event": {
          "type": "string",
          "minLength": 1
        },
        "spoken_response": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 3,
          "maximum": 8
        },
        "media_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observable_expression": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "numericObligation": {
      "type": "object",
      "required": [
        "initial_amount",
        "currency"
      ],
      "properties": {
        "initial_amount": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "privatePersonaV2": {
      "type": "object",
      "required": [
        "name",
        "role",
        "core_values",
        "temperament",
        "communication_style",
        "decision_style",
        "conflict_style",
        "boundaries"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "core_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temperament": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "communication_style": {
          "type": "string",
          "minLength": 1
        },
        "decision_style": {
          "type": "string",
          "minLength": 1
        },
        "conflict_style": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stateSelectionV2": {
      "type": "object",
      "required": [
        "emotion",
        "behavioral_disposition",
        "relationship",
        "consequence_risk"
      ],
      "properties": {
        "emotion": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "anger",
              "anxiety",
              "hope",
              "sadness",
              "fear",
              "guilt",
              "shame",
              "disappointment",
              "frustration",
              "relief"
            ]
          }
        },
        "behavioral_disposition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resolve",
              "avoidance_urge",
              "repair_intent",
              "resistance_intent",
              "disclosure_willingness",
              "cooperation_readiness",
              "evidence_seeking",
              "boundary_assertion"
            ]
          }
        },
        "relationship": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trust",
              "hostility",
              "respect",
              "perceived_safety",
              "affiliation",
              "perceived_fairness"
            ]
          }
        },
        "consequence_risk": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "goal_failure_risk",
              "relationship_rupture_risk",
              "reputational_harm_risk",
              "material_loss_risk",
              "safety_harm_risk",
              "institutional_harm_risk",
              "commitment_breach_risk",
              "exclusion_risk"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "initialStateV2": {
      "type": "object",
      "required": [
        "emotion",
        "behavioral_disposition",
        "relationship",
        "consequence_risk"
      ],
      "properties": {
        "emotion": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "behavioral_disposition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "relationship": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "consequence_risk": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "additionalProperties": false
    },
    "initialDynamicsV2": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 5,
      "propertyNames": {
        "enum": [
          "deadline_pressure",
          "resource_scarcity",
          "information_asymmetry",
          "public_exposure",
          "negotiation_openness",
          "coordination_stability",
          "institutional_constraint"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "environmentAgentV2": {
      "type": "object",
      "required": [
        "persona",
        "explicit_goal",
        "hidden_intention"
      ],
      "properties": {
        "persona": {
          "$ref": "#/$defs/privatePersonaV2"
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "hidden_intention": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "A scenario defines a social world, never a navigation strategy or expected action transition. Rollouts must come from free-form model interaction.",
  "allOf": [
    {
      "if": {
        "required": [
          "state_contract_version"
        ],
        "properties": {
          "state_contract_version": {
            "const": "socialflux_state_v2"
          }
        }
      },
      "then": {
        "required": [
          "selected_state_variables"
        ],
        "properties": {
          "environment_agent": {
            "$ref": "#/$defs/environmentAgentV2"
          },
          "selected_state_variables": {
            "$ref": "#/$defs/stateSelectionV2"
          },
          "initial_state": {
            "$ref": "#/$defs/initialStateV2"
          },
          "initial_dynamics": {
            "$ref": "#/$defs/initialDynamicsV2"
          }
        }
      }
    }
  ]
}
