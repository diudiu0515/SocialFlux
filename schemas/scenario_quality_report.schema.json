{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/scenario-quality-report-v1.json",
  "title": "SocialFlux Source Narrative Quality Report",
  "type": "object",
  "required": [
    "format",
    "source_type",
    "checks",
    "recommendation",
    "summary",
    "review_status"
  ],
  "properties": {
    "format": {
      "const": "socialflux_source_quality_v1"
    },
    "source_type": {
      "enum": [
        "narrative-derived",
        "synthetic-script"
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "social_plausibility",
        "real_tradeoff",
        "longitudinal_necessity",
        "nontrivial_strategy_space",
        "character_motivation_coherence",
        "information_asymmetry",
        "t1_suitability",
        "t2_suitability",
        "t3_suitability",
        "t4_adaptation_opportunity",
        "no_universal_script"
      ],
      "additionalProperties": false,
      "properties": {
        "social_plausibility": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "real_tradeoff": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "longitudinal_necessity": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "nontrivial_strategy_space": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "character_motivation_coherence": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "information_asymmetry": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "t1_suitability": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "t2_suitability": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "t3_suitability": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "t4_adaptation_opportunity": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        },
        "no_universal_script": {
          "enum": [
            "pass",
            "revise",
            "fail"
          ]
        }
      }
    },
    "recommendation": {
      "enum": [
        "pass",
        "revise",
        "reject"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "pending_human_review",
        "approved",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
