{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/observable-expression-v1.json",
  "title": "Observable expression",
  "type": "object",
  "required": [
    "facial_expression",
    "gaze",
    "speech_style",
    "prosody",
    "behavioral_cues"
  ],
  "properties": {
    "facial_expression": {
      "type": "string"
    },
    "gaze": {
      "type": "string"
    },
    "speech_style": {
      "type": "string"
    },
    "prosody": {
      "type": "string"
    },
    "behavioral_cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
