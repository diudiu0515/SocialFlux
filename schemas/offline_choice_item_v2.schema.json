{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SocialFlux offline choice author record v2",
  "type": "object",
  "required": [
    "instance_id",
    "benchmark_version",
    "task",
    "subtype",
    "story_id",
    "pair_id",
    "modality",
    "input",
    "question",
    "options",
    "target_spec",
    "ground_truth",
    "metadata",
    "authoring",
    "analysis"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "const": "socialflux_offline_choice_v2"
    },
    "task": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "subtype": {
      "type": "string",
      "enum": [
        "action_selection",
        "consequence_explanation",
        "current_state",
        "evidence_support",
        "expression_meaning",
        "history_comparison",
        "history_evidence",
        "interval_change",
        "joint_comparison",
        "state_combination"
      ]
    },
    "story_id": {
      "type": "string"
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "modality": {
      "enum": [
        "text",
        "text+video"
      ]
    },
    "input": {
      "type": "object"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 4,
      "propertyNames": {
        "pattern": "^[A-F]$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_spec": {
      "type": "object",
      "required": [
        "target_state_ids",
        "state_owner",
        "state_target",
        "time_scope"
      ],
      "properties": {
        "target_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "state_owner": {
          "type": "string"
        },
        "state_target": {
          "type": "string"
        },
        "time_scope": {
          "type": "string"
        },
        "delayed_horizon": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10
        }
      }
    },
    "ground_truth": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "acceptable_answers"
          ],
          "properties": {
            "acceptable_answers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ]
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "source_trajectory_id"
      ],
      "properties": {
        "source_trajectory_id": {
          "type": "string"
        }
      }
    },
    "authoring": {
      "type": "object",
      "required": [
        "answer",
        "evidence_ids",
        "option_errors",
        "option_variable_map",
        "review_status",
        "construction_source",
        "history_dependence",
        "nonverbal_history_relation",
        "rationale",
        "counterevidence_ids",
        "generation_source",
        "review_protocol"
      ],
      "properties": {
        "answer": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "option_errors": {
          "type": "object"
        },
        "option_variable_map": {
          "type": "object"
        },
        "review_status": {
          "enum": [
            "pending_human_review",
            "human_approved",
            "needs_revision"
          ]
        },
        "counterevidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "generation_source": {
          "type": "object"
        },
        "review_protocol": {
          "enum": [
            "human_verification",
            "human_annotation"
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "primary_capability",
        "auxiliary_capabilities",
        "design_difficulty",
        "difficulty_reason",
        "empirical_difficulty",
        "state_bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_capability": {
          "enum": [
            "situational_evidence_integration",
            "multidimensional_state_distinction",
            "temporal_dynamics_reasoning"
          ]
        },
        "auxiliary_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "situational_evidence_integration",
              "multidimensional_state_distinction",
              "temporal_dynamics_reasoning"
            ]
          }
        },
        "design_difficulty": {
          "enum": [
            "ordinary",
            "hard"
          ]
        },
        "difficulty_reason": {
          "type": "string"
        },
        "empirical_difficulty": {
          "type": [
            "null",
            "object"
          ]
        },
        "state_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "state_id",
              "owner",
              "object"
            ],
            "properties": {
              "state_id": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "object": {
                "type": "string"
              },
              "risk_event": {
                "type": "string"
              },
              "risk_window": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Cross-field boundaries, edit fidelity, direction, windows and capability/state separation are enforced by tasks.offline_choice.validate_item and tasks.offline_design.validate_design."
}
