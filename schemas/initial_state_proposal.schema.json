{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/initial-state-proposal-v1.json",
  "title": "SocialFlux Candidate Initial State",
  "type": "object",
  "required": [
    "initial_state",
    "initial_dynamics",
    "observable_expression",
    "media_generation",
    "video_triggers",
    "max_turns",
    "t3_delayed_horizon",
    "sampling_plan",
    "rationale",
    "trigger_reachability",
    "status"
  ],
  "properties": {
    "initial_state": {
      "type": "object",
      "required": [
        "emotion",
        "behavioral_disposition",
        "relationship",
        "consequence_risk"
      ],
      "properties": {
        "emotion": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "behavioral_disposition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "relationship": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "consequence_risk": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "additionalProperties": false
    },
    "initial_dynamics": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 5,
      "propertyNames": {
        "enum": [
          "deadline_pressure",
          "resource_scarcity",
          "information_asymmetry",
          "public_exposure",
          "negotiation_openness",
          "coordination_stability",
          "institutional_constraint"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "observable_expression": {
      "type": "object"
    },
    "media_generation": {
      "type": "object"
    },
    "video_triggers": {
      "type": "array"
    },
    "max_turns": {
      "const": 20
    },
    "t3_delayed_horizon": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "sampling_plan": {
      "type": "object"
    },
    "rationale": {
      "type": "object"
    },
    "trigger_reachability": {
      "type": "array"
    },
    "status": {
      "const": "candidate_pending_human_freeze"
    }
  },
  "additionalProperties": false
}
