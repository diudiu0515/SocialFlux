{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/trajectory-v2.json",
  "title": "SocialFlux Free-form Model Trajectory",
  "type": "object",
  "required": [
    "trajectory_id",
    "scenario_id",
    "policy_id",
    "policy_provenance",
    "environment_provenance",
    "initial_state",
    "initial_dynamics",
    "turns",
    "ending"
  ],
  "properties": {
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_provenance": {
      "type": "object",
      "required": [
        "policy_id",
        "provider",
        "model",
        "prompt_id",
        "sampling"
      ]
    },
    "environment_provenance": {
      "type": "object"
    },
    "initial_state": {
      "type": "object"
    },
    "initial_dynamics": {
      "type": "object"
    },
    "longitudinal_design_version": {
      "type": ["string", "null"]
    },
    "event_plan": {
      "type": "object"
    },
    "segments": {
      "type": "array"
    },
    "public_timeline": {
      "type": "array"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "turn_id",
          "policy_action",
          "appraisal",
          "state_before",
          "state_delta",
          "state_after",
          "dynamics_before",
          "dynamics_delta",
          "dynamics_after",
          "environment_response",
          "observation",
          "observation_after"
        ],
        "properties": {
          "policy_action": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "action_id": false
            },
            "additionalProperties": true
          },
          "trigger_events": {
            "type": "array"
          },
          "observable_expression": {
            "type": "object"
          },
          "media": {
            "type": "array"
          },
          "environment_snapshot_before": {
            "type": "object"
          },
          "segment_id": {
            "type": "string"
          },
          "segment_turn_id": {
            "type": "integer",
            "minimum": 1
          },
          "elapsed_time_before": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_time_after": {
            "type": "integer",
            "minimum": 0
          },
          "segment_transition_after": {
            "type": ["object", "null"]
          },
          "state_after_public_events": {
            "type": "object"
          },
          "dynamics_after_public_events": {
            "type": "object"
          },
          "observation": {
            "type": "object"
          },
          "observation_after": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "ending": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "$comment": "Every action is arbitrary model-generated text. policy_id identifies a model/sampling run, never a behavioral strategy."
}
