{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/task-t2-output-v2.json",
  "title": "SocialFlux T2 history-conditioned comparison output v2",
  "type": "object",
  "required": [
    "instance_id",
    "selected_state_ids",
    "predictions",
    "shared_expression_explanation",
    "history_necessity"
  ],
  "properties": {
    "instance_id": {"type": "string", "minLength": 1},
    "selected_state_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "direction_probabilities",
          "evidence_a",
          "evidence_b",
          "key_history_events_a",
          "key_history_events_b",
          "rationale",
          "confidence"
        ],
        "properties": {
          "state_id": {"type": "string", "minLength": 1},
          "direction_probabilities": {
            "type": "object",
            "required": ["higher_in_a", "similar", "higher_in_b", "cannot_determine"],
            "properties": {
              "higher_in_a": {"type": "number", "minimum": 0, "maximum": 1},
              "similar": {"type": "number", "minimum": 0, "maximum": 1},
              "higher_in_b": {"type": "number", "minimum": 0, "maximum": 1},
              "cannot_determine": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          },
          "evidence_a": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["turn_id", "target_quote", "interpretation"],
              "properties": {
                "turn_id": {"type": "string", "pattern": "^t[1-9][0-9]*$"},
                "target_quote": {"type": "string", "minLength": 1},
                "interpretation": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "evidence_b": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["turn_id", "target_quote", "interpretation"],
              "properties": {
                "turn_id": {"type": "string", "pattern": "^t[1-9][0-9]*$"},
                "target_quote": {"type": "string", "minLength": 1},
                "interpretation": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "key_history_events_a": {
            "type": "array",
            "minItems": 0,
            "items": {"type": "string"}
          },
          "key_history_events_b": {
            "type": "array",
            "minItems": 0,
            "items": {"type": "string"}
          },
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "shared_expression_explanation": {
      "type": "object",
      "required": ["history_a", "history_b", "uncertainty"],
      "properties": {
        "history_a": {"type": "string", "minLength": 1},
        "history_b": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "history_necessity": {
      "type": "object",
      "required": ["judgment", "explanation"],
      "properties": {
        "judgment": {
          "enum": ["necessary", "partially_necessary", "not_demonstrated"]
        },
        "explanation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
