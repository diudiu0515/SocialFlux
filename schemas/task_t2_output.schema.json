{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/task-t2-output-v1.json",
  "title": "T2 model output",
  "type": "object",
  "required": [
    "instance_id",
    "predictions"
  ],
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "direction_probabilities",
          "evidence_a",
          "evidence_b",
          "causal_relevance",
          "confidence"
        ],
        "properties": {
          "state_id": {
            "type": "string"
          },
          "direction_probabilities": {
            "type": "object",
            "required": [
              "higher_in_a",
              "similar",
              "higher_in_b",
              "cannot_determine"
            ],
            "properties": {
              "higher_in_a": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "similar": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "higher_in_b": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cannot_determine": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "evidence_a": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_b": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "causal_relevance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
