{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialflux.example/schemas/scenario-blueprint-v1.json",
  "title": "SocialFlux Normalized Scenario Blueprint",
  "type": "object",
  "required": [
    "scenario_id",
    "title",
    "mechanism",
    "source",
    "narrative_design",
    "background",
    "state_contract_version",
    "environment_agent",
    "evaluated_agent_role",
    "selected_state_variables",
    "target_state_ids"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "provenance_id",
        "surface_text_policy",
        "redistribution_status"
      ],
      "properties": {
        "type": {
          "enum": [
            "narrative-derived",
            "synthetic-script"
          ]
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_text_policy": {
          "const": "original_surface_text"
        },
        "redistribution_status": {
          "type": "string",
          "minLength": 1
        },
        "provenance_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "narrative_design": {
      "type": "object",
      "required": [
        "relationship_structure",
        "power_structure",
        "goal_conflict",
        "information_asymmetry",
        "relevant_history",
        "meaningful_choice_space"
      ],
      "properties": {
        "relationship_structure": {
          "type": "string",
          "minLength": 1
        },
        "power_structure": {
          "type": "string",
          "minLength": 1
        },
        "goal_conflict": {
          "type": "string",
          "minLength": 1
        },
        "information_asymmetry": {
          "type": "string",
          "minLength": 1
        },
        "relevant_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "meaningful_choice_space": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "environment_agent": {
      "$ref": "#/$defs/environmentAgent"
    },
    "evaluated_agent_role": {
      "type": "object",
      "required": [
        "character_id",
        "name",
        "role",
        "explicit_goal"
      ],
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selected_state_variables": {
      "$ref": "#/$defs/stateSelectionV2"
    },
    "target_state_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "multimodal_event_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_horizon": {
      "const": 20
    },
    "state_contract_version": {
      "const": "socialflux_state_v2"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "initial_state"
        ]
      },
      {
        "required": [
          "initial_dynamics"
        ]
      },
      {
        "required": [
          "action_effects"
        ]
      },
      {
        "required": [
          "response_templates"
        ]
      }
    ]
  },
  "additionalProperties": false,
  "$comment": "Normalization produces social structure first. State configuration and numeric triggers happen only after quality review.",
  "$defs": {
    "environmentAgent": {
      "type": "object",
      "required": [
        "persona",
        "explicit_goal",
        "hidden_intention"
      ],
      "properties": {
        "persona": {
          "$ref": "#/$defs/privatePersonaV2"
        },
        "explicit_goal": {
          "type": "string",
          "minLength": 1
        },
        "hidden_intention": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "privatePersonaV2": {
      "type": "object",
      "required": [
        "name",
        "role",
        "core_values",
        "temperament",
        "communication_style",
        "decision_style",
        "conflict_style",
        "boundaries"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "core_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temperament": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "communication_style": {
          "type": "string",
          "minLength": 1
        },
        "decision_style": {
          "type": "string",
          "minLength": 1
        },
        "conflict_style": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stateSelectionV2": {
      "type": "object",
      "required": [
        "emotion",
        "behavioral_disposition",
        "relationship",
        "consequence_risk"
      ],
      "properties": {
        "emotion": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "anger",
              "anxiety",
              "hope",
              "sadness",
              "fear",
              "guilt",
              "shame",
              "disappointment",
              "frustration",
              "relief"
            ]
          }
        },
        "behavioral_disposition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resolve",
              "avoidance_urge",
              "repair_intent",
              "resistance_intent",
              "disclosure_willingness",
              "cooperation_readiness",
              "evidence_seeking",
              "boundary_assertion"
            ]
          }
        },
        "relationship": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trust",
              "hostility",
              "respect",
              "perceived_safety",
              "affiliation",
              "perceived_fairness"
            ]
          }
        },
        "consequence_risk": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "goal_failure_risk",
              "relationship_rupture_risk",
              "reputational_harm_risk",
              "material_loss_risk",
              "safety_harm_risk",
              "institutional_harm_risk",
              "commitment_breach_risk",
              "exclusion_risk"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
