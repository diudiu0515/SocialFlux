{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/annotation-overlay-v0.1.json",
  "title": "EmoTree Human Annotation Overlay",
  "type": "object",
  "required": [
    "annotation_id",
    "instance_id",
    "task_type",
    "annotator_id",
    "response",
    "confidence",
    "created_at",
    "quality_status"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "task_type": {
      "enum": [
        "T1_state_tracking",
        "T2_history_sensitive_merge",
        "T3_counterfactual_choice_effect"
      ]
    },
    "annotator_id": {
      "type": "string"
    },
    "response": {
      "type": "object",
      "minProperties": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "response_time_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "modality_seen": {
      "enum": [
        "text",
        "text_video"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_status": {
      "enum": [
        "unreviewed",
        "accepted",
        "rejected"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
