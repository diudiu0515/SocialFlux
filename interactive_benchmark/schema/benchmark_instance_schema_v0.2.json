{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/benchmark-instance-v0.2.json",
  "title": "EmoTree Interactive Benchmark Instance v0.2",
  "type": "object",
  "required": [
    "instance_id",
    "benchmark_version",
    "story_id",
    "story_version",
    "task_type",
    "language",
    "split",
    "modality",
    "input",
    "target_spec",
    "ground_truth",
    "label_status",
    "metadata"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string"
    },
    "story_id": {
      "type": "string",
      "pattern": "^IA[0-9]{3,}$"
    },
    "story_version": {
      "type": "string"
    },
    "task_type": {
      "enum": [
        "T1_state_tracking",
        "T2_history_sensitive_merge",
        "T3_counterfactual_choice_effect"
      ]
    },
    "language": {
      "type": "string"
    },
    "split": {
      "enum": [
        "unassigned",
        "train",
        "validation",
        "test"
      ]
    },
    "modality": {
      "enum": [
        "text",
        "text_video"
      ]
    },
    "input": {
      "type": "object",
      "minProperties": 3
    },
    "target_spec": {
      "type": "object",
      "required": [
        "prediction_format",
        "target_state_ids"
      ],
      "properties": {
        "prediction_format": {
          "enum": [
            "subjective_state_tracking_v0.2",
            "pairwise_state_difference_v0.2",
            "counterfactual_option_effects_v0.2"
          ]
        },
        "target_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "require_confidence": {
          "type": "boolean"
        },
        "require_self_reported_confidence": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "ground_truth": {
      "type": [
        "object",
        "null"
      ]
    },
    "label_status": {
      "enum": [
        "pending_human_annotation",
        "human_annotation_in_progress",
        "human_validated"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "source_type",
        "author_effects_exposed"
      ],
      "properties": {
        "source_type": {
          "const": "synthetic_interactive_story"
        },
        "author_effects_exposed": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "semantic_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
