{
  "format": "socialflux_model_routes_v1",
  "description": "Single active AutoDL route table. Every LLM role uses an independent claude-fable-5 request; Appraisal and Response remain separate stages.",
  "selection_report": "reports/experiments/2026-09-17_autodl_board_model_selection.md",
  "provider_defaults": {
    "provider": "anthropic",
    "endpoint": "https://www.autodl.art/api/v1/anthropic/v1/messages",
    "use_proxy": false,
    "auth_scheme": "bearer",
    "api_key_env": "AUTODL_API_KEY",
    "api_key_file": "/root/.config/socialflux/autodl_api_key",
    "model": "claude-fable-5",
    "stream": false,
    "timeout": 600,
    "max_transport_attempts": 4,
    "retry_backoff_seconds": 10
  },
  "routes": {
    "scenario_authoring": {"max_tokens": 5000},
    "scenario_normalization": {"max_tokens": 8000},
    "scenario_initialization": {"max_tokens": 6000},
    "policy": {"max_tokens": 1200},
    "appraisal": {"max_tokens": 3500},
    "response": {"max_tokens": 2600},
    "t2_branch_authoring": {"max_tokens": 5000},
    "t2_spec_authoring": {"max_tokens": 3500},
    "t2_pair_review": {"max_tokens": 3500},
    "t2_answer": {"max_tokens": 5000},
    "t2_answer_review": {"max_tokens": 3500},
    "task_extraction": {"max_tokens": 3500},
    "t1_answer": {"max_tokens": 5000},
    "t3_action_authoring": {"max_tokens": 1800},
    "t3_answer": {"max_tokens": 6500},
    "t4_judge": {"max_tokens": 3500},
    "quality_review": {"max_tokens": 3000},
    "legacy_task_bundle": {"max_tokens": 6500}
  }
}
