{
  "format": "socialflux_task_model_benchmark_v1",
  "endpoint": "https://llmapi.paratera.com/v1/chat/completions",
  "api_key_env": "SOCIALFLUX_API_KEY",
  "models": ["Qwen3.8-Max", "DeepSeek-V4-Pro-0813", "MiniMax-M3"],
  "roles": ["t1_answer", "t2_answer", "t3_action_authoring", "t3_answer", "t4_judge"],
  "scenario_count": 50,
  "retry_limit": 2,
  "request_budget": 1500,
  "selection": {
    "generation_statuses": ["accepted", "short_natural_trajectory"],
    "model_semantic_decision": "approve",
    "minimum_turns": 6,
    "require_tasks": ["T1", "T2", "T3", "T4"],
    "require_current_source_artifact": true,
    "stratify_first_by": "conflict_structure",
    "balance_fields": ["source_type", "turn_bin"]
  }
}
