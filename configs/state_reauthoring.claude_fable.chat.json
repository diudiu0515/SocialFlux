{
  "format": "socialflux_model_routes_v1",
  "description": "State-only authoring route pinned to the Claude chat candidate verified by the 2026-09-27 pilot.",
  "provider_defaults": {
    "provider": "openai_compatible",
    "endpoint": "https://www.autodl.art/api/v1/chat/completions",
    "use_proxy": false,
    "api_key_file": "/root/.config/socialflux/autodl_api_key",
    "model": "claude-fable-5",
    "stream": false,
    "timeout": 240,
    "max_transport_attempts": 4,
    "retry_backoff_seconds": 20
  },
  "routes": {
    "scenario_initialization": {
      "max_tokens": 6000
    },
    "state_semantic_triage": {
      "max_tokens": 2600
    }
  }
}
