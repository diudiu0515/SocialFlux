{
  "format": "socialflux_rollout_pool_v1",
  "environment": {
    "provider": {
      "provider": "openai_compatible",
      "endpoint": "https://YOUR_ENVIRONMENT_ENDPOINT/v1/chat/completions",
      "model": "YOUR_ENVIRONMENT_MODEL",
      "api_key_env": "SOCIALFLUX_ENV_API_KEY",
      "timeout": 60
    },
    "sampling": {
      "temperature": 0.2,
      "seed": 4100
    }
  },
  "construction": {
