      "provider": "openai_compatible",
      "endpoint": "https://YOUR_CONSTRUCTION_ENDPOINT/v1/chat/completions",
      "model": "YOUR_CONSTRUCTION_MODEL",
      "api_key_env": "SOCIALFLUX_CONSTRUCTION_API_KEY",
      "timeout": 60
    },
    "sampling": {
      "temperature": 0.5,
      "seed": 5100
    }
  },
  "policies": [
    {
      "policy_id": "model_a_seed_1",
