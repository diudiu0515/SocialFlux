{
  "format": "socialflux_multimodal_generation_v1",
  "prompt_id": "talking_head_generation_v4",
  "offline": {
    "selection": "trajectory_importance_v1",
    "important_nodes_per_trajectory": 4,
    "videos_per_node": 1,
    "min_turn_gap": 2,
    "duration_policy": "estimated_from_public_response_v1",
    "minimum_duration_seconds": 3,
    "maximum_duration_seconds": 15
  },
  "online": {
    "profile": "online_multimodal_v2",
    "threshold_margin": 0,
    "change_threshold_margin": 0,
    "cooldown_turns": 2,
    "crossing_as_threshold": true,
    "max_events_per_turn": 1,
    "max_events_per_episode": 5,
    "max_fires_per_trigger": 1,
    "global_cooldown_turns": 2,
    "event_family_cooldown_turns": 3
  },
  "gate2": {
    "video_review_sample_count": 40,
    "minimum_generated_video_count": 40,
    "require_llm_review": false,
    "require_human_attestation": true
  },
  "expression_rendering": {
    "profile": "subtle_contextual_v1",
    "default_intensity": "low_to_moderate",
    "maximum_behavioral_cues": 2,
    "require_public_text_and_context_alignment": true,
    "allow_exaggerated_acting": false,
    "apply_cues_sequentially_when_possible": true
  },
  "delivery": {
    "resolution": "720p",
    "ratio": "16:9",
    "require_scenario_identity_reference": true,
    "require_exact_public_response": true,
    "require_lip_sync_review": true,
    "require_natural_conversational_delivery": true,
    "disallow_word_by_word_recitation": true,
    "require_human_attestation": true
  }
}
