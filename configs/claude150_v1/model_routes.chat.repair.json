{
  "format": "socialflux_model_routes_v1",
  "description": "State-transition-v2 Claude rollout route isolated from the GPT reference-environment credential.",
  "provider_defaults": {
    "provider": "failover",
    "model": "claude-fable-5",
    "stream": false,
    "candidates": [
      {
        "provider": "openai_compatible",
        "endpoint": "https://www.autodl.art/api/v1/chat/completions",
        "use_proxy": false,
        "api_key_file": "/root/.config/socialflux/autodl_api_key_2",
        "model": "claude-fable-5",
        "timeout": 600
      },
      {
        "provider": "anthropic",
        "endpoint": "https://www.autodl.art/api/v1/anthropic/v1/messages",
        "use_proxy": false,
        "auth_scheme": "bearer",
        "api_key_file": "/root/.config/socialflux/autodl_api_key_2",
        "model": "claude-fable-5",
        "timeout": 600,
        "max_transport_attempts": 1
      }
    ],
    "timeout": 240,
    "circuit_failure_threshold": 2,
    "circuit_cooldown_seconds": 90,
    "circuit_max_cooldown_seconds": 300,
    "failover_backoff_base_seconds": 2,
    "failover_backoff_max_seconds": 15,
    "failover_backoff_jitter_seconds": 1.5,
    "max_candidates_per_request": 2
  },
  "routes": {
    "policy": {"max_tokens": 1200, "timeout": 90},
    "appraisal": {"max_tokens": 3500, "timeout": 120},
    "response": {"max_tokens": 2600, "timeout": 120},
    "t2_branch_authoring": {"max_tokens": 5000, "timeout": 240}
  }
}
