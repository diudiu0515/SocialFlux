{
  "format": "socialflux_model_routes_v1",
  "description": "Isolated GPT-50 development route. Every semantic role uses an independent gpt-6-astra request.",
  "provider_defaults": {
    "provider": "openai_compatible",
    "endpoint": "https://www.autodl.art/api/v1/chat/completions",
    "use_proxy": false,
    "api_key_env": "AUTODL_GPT_API_KEY",
    "api_key_file": "/root/.config/socialflux/autodl_gpt_api_key",
    "model": "gpt-6-astra",
    "stream": true,
    "reasoning_effort": "low",
    "timeout": 600
  },
  "routes": {
    "scenario_authoring": {"max_tokens": 2200},
    "scenario_normalization": {"max_tokens": 4000, "timeout": 600},
    "scenario_initialization": {"max_tokens": 4000, "timeout": 600},
    "policy": {"max_tokens": 250, "timeout": 120},
    "appraisal": {"max_tokens": 900, "timeout": 180},
    "response": {"max_tokens": 300, "timeout": 120},
    "t2_branch_authoring": {"max_tokens": 5000},
    "t2_spec_authoring": {"max_tokens": 3500},
    "t2_pair_review": {"max_tokens": 3500},
    "t2_answer": {"max_tokens": 5000},
    "t2_answer_review": {"max_tokens": 3500},
    "task_extraction": {"max_tokens": 3500},
    "t1_answer": {"max_tokens": 5000},
    "t3_action_authoring": {"max_tokens": 1800},
    "t3_answer": {"max_tokens": 6500},
    "t4_judge": {"max_tokens": 3500},
    "quality_review": {"max_tokens": 1600}
  }
}
