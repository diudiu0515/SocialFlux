{
  "format": "socialflux_rollout_pool_v1",
  "pool_stage": "development",
  "candidate_strategy": "single_first_pass",
  "model_routes": "model_routes.astra.json",
  "model_assignment": {
    "strategy": "single_model_all_llm_roles",
    "model": "gpt-6-astra",
    "independent_calls": true
  },
  "environment": {
    "horizon_mode": "natural_max_20",
    "appraisal_prompt_id": "environment_appraisal_v11",
    "response_prompt_id": "environment_response_v25",
    "response_validation_profile": "hard_only",
    "provider": {"model_route": "appraisal"},
    "sampling": {"temperature": 0.2, "top_p": 0.9, "seed": 16100},
    "response_provider": {"model_route": "response"},
    "response_sampling": {"temperature": 0.35, "top_p": 0.9, "seed": 16300}
  },
  "construction": {
    "provider": {"model_route": "t2_branch_authoring"},
    "sampling": {"temperature": 0.3, "top_p": 0.9, "seed": 17100}
  },
  "policies": [
    {
      "policy_id": "gpt6_astra_single_18201",
      "prompt_id": "task_t4_action_v21",
      "horizon_mode": "natural_max_20",
      "source_type": "api",
      "model_family": "openai",
      "provider": {"model_route": "policy"},
      "sampling": {"temperature": 0.65, "top_p": 0.92, "seed": 18201},
      "runs": 1
    }
  ],
  "pilot_limits": {
    "rollout_turns": 20,
    "t1": 6,
    "t2": 2,
    "t3": 1,
    "t3_horizon": 5
  },
  "t2_pairing": "all",
  "task_source_selection": {
    "strategy": "quality_gate_then_task_specific_weighted_ranking",
    "t1_sources": 1,
    "model_quota": false
  }
}
