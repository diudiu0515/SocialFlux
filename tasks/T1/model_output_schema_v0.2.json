{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/t1-model-output-v0.2.json",
  "title": "EmoTree T1 Model Output v0.2",
  "type": "object",
  "required": [
    "instance_id",
    "state_predictions"
  ],
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "state_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "intensity_probabilities",
          "predicted_intensity",
          "change_probabilities",
          "predicted_change",
          "evidence_node_ids"
        ],
        "properties": {
          "state_id": {
            "type": "string"
          },
          "intensity_probabilities": {
            "type": "object",
            "required": [
              "absent",
              "mild",
              "moderate",
              "strong",
              "very_strong",
              "cannot_determine"
            ],
            "properties": {
              "absent": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "mild": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "moderate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "strong": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "very_strong": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cannot_determine": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "predicted_intensity": {
            "enum": [
              "absent",
              "mild",
              "moderate",
              "strong",
              "very_strong",
              "cannot_determine"
            ]
          },
          "change_probabilities": {
            "type": "object",
            "required": [
              "increase",
              "similar",
              "decrease",
              "cannot_determine"
            ],
            "properties": {
              "increase": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "similar": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "decrease": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cannot_determine": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "predicted_change": {
            "enum": [
              "increase",
              "similar",
              "decrease",
              "cannot_determine"
            ]
          },
          "evidence_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$comment": "Probability objects must sum to 1 within numerical tolerance; enforce in the evaluator."
}
