{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/t3-model-output-v0.2.json",
  "title": "EmoTree T3 Model Output v0.2",
  "type": "object",
  "required": [
    "instance_id",
    "option_predictions"
  ],
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "option_predictions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/optionPrediction"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "directionProbabilities": {
      "type": "object",
      "required": [
        "increase",
        "similar",
        "decrease",
        "cannot_determine"
      ],
      "properties": {
        "increase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "similar": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decrease": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cannot_determine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "horizonPrediction": {
      "type": "object",
      "required": [
        "direction_probabilities",
        "predicted_direction"
      ],
      "properties": {
        "direction_probabilities": {
          "$ref": "#/$defs/directionProbabilities"
        },
        "predicted_direction": {
          "enum": [
            "increase",
            "similar",
            "decrease",
            "cannot_determine"
          ]
        }
      },
      "additionalProperties": false
    },
    "stateEffect": {
      "type": "object",
      "required": [
        "state_id",
        "immediate",
        "delayed",
        "evidence_node_ids"
      ],
      "properties": {
        "state_id": {
          "type": "string"
        },
        "immediate": {
          "$ref": "#/$defs/horizonPrediction"
        },
        "delayed": {
          "$ref": "#/$defs/horizonPrediction"
        },
        "evidence_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "optionPrediction": {
      "type": "object",
      "required": [
        "option_id",
        "state_effects"
      ],
      "properties": {
        "option_id": {
          "type": "string"
        },
        "state_effects": {
          "type": "array",
          "minItems": 6,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/stateEffect"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Probability objects sum to 1. Confidence and rankings are derived."
}
