{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/t3-human-annotation-v0.2.json",
  "title": "EmoTree T3 Human Annotation v0.2",
  "type": "object",
  "required": [
    "annotation_id",
    "instance_id",
    "annotator_id",
    "option_annotations",
    "quality_status"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "annotator_id": {
      "type": "string"
    },
    "option_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "option_annotations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/humanOptionAnnotation"
      }
    },
    "quality_status": {
      "enum": [
        "accepted",
        "rejected",
        "needs_review"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "humanHorizon": {
      "type": "object",
      "required": [
        "direction",
        "confidence"
      ],
      "properties": {
        "direction": {
          "enum": [
            "increase",
            "similar",
            "decrease",
            "cannot_determine"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "very_high"
          ]
        }
      },
      "additionalProperties": false
    },
    "humanStateEffect": {
      "type": "object",
      "required": [
        "state_id",
        "immediate",
        "delayed",
        "evidence_node_ids"
      ],
      "properties": {
        "state_id": {
          "type": "string"
        },
        "immediate": {
          "$ref": "#/$defs/humanHorizon"
        },
        "delayed": {
          "$ref": "#/$defs/humanHorizon"
        },
        "evidence_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "humanOptionAnnotation": {
      "type": "object",
      "required": [
        "option_id",
        "state_effects"
      ],
      "properties": {
        "option_id": {
          "type": "string"
        },
        "state_effects": {
          "type": "array",
          "minItems": 6,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/humanStateEffect"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
