{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/t2-model-output-v0.2.json",
  "title": "EmoTree T2 Model Output v0.2",
  "type": "object",
  "required": [
    "instance_id",
    "state_comparisons",
    "causal_choice_predictions"
  ],
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "state_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "direction_probabilities",
          "predicted_direction",
          "evidence_node_ids_a",
          "evidence_node_ids_b"
        ],
        "properties": {
          "state_id": {
            "type": "string"
          },
          "direction_probabilities": {
            "type": "object",
            "required": [
              "higher_in_a",
              "similar",
              "higher_in_b",
              "cannot_determine"
            ],
            "properties": {
              "higher_in_a": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "similar": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "higher_in_b": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cannot_determine": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "predicted_direction": {
            "enum": [
              "higher_in_a",
              "similar",
              "higher_in_b",
              "cannot_determine"
            ]
          },
          "evidence_node_ids_a": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "evidence_node_ids_b": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "causal_choice_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "choice_id",
          "relevance_probability",
          "selected"
        ],
        "properties": {
          "choice_id": {
            "type": "string"
          },
          "relevance_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "selected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$comment": "Each direction_probabilities object must sum to 1 within numerical tolerance. Causal relevance probabilities are independent and do not sum to 1."
}
