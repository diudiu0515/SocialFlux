{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotree.example/schemas/t2-human-annotation-v0.2.json",
  "title": "EmoTree T2 Human Annotation v0.2",
  "type": "object",
  "required": [
    "annotation_id",
    "instance_id",
    "annotator_id",
    "task_type",
    "presentation_order",
    "state_comparisons",
    "causal_choice_annotations",
    "created_at",
    "quality_status"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "annotator_id": {
      "type": "string"
    },
    "task_type": {
      "const": "T2_history_sensitive_merge"
    },
    "presentation_order": {
      "enum": [
        "AB",
        "BA"
      ]
    },
    "state_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "direction_label",
          "annotator_confidence",
          "evidence_node_ids_a",
          "evidence_node_ids_b"
        ],
        "properties": {
          "state_id": {
            "type": "string"
          },
          "direction_label": {
            "enum": [
              "higher_in_a",
              "similar",
              "higher_in_b",
              "cannot_determine"
            ]
          },
          "annotator_confidence": {
            "enum": [
              "low",
              "medium",
              "high",
              "very_high"
            ]
          },
          "evidence_node_ids_a": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "evidence_node_ids_b": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "optional_comment": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "causal_choice_annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "choice_id",
          "is_causal",
          "annotator_confidence"
        ],
        "properties": {
          "choice_id": {
            "type": "string"
          },
          "is_causal": {
            "type": "boolean"
          },
          "annotator_confidence": {
            "enum": [
              "low",
              "medium",
              "high",
              "very_high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "response_time_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_status": {
      "enum": [
        "unreviewed",
        "accepted",
        "rejected"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
